# Copy to apps/web/.env.local for local work. Never commit a filled-in file (.env* is gitignored).
# Values for the local stack come from `supabase status -o env`; hosted values live in Vercel
# and Supabase settings only (docs/11 section 2).

# Public: safe to expose to the browser (the anon/publishable key is governed by row-level security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-local-anon-key

# Server-only secrets: never prefix with NEXT_PUBLIC_, never import in browser code.
# Used by the rule runner route and the admin scripts.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-local-service-role-key
